# Marka
NEXT_PUBLIC_BRAND="YSMN"
NEXT_PUBLIC_BRAND_LONG="YSMN Leather Atelier"

# İletişim — WhatsApp numarası uluslararası formatta, yalnızca rakam (başında + yok)
NEXT_PUBLIC_WHATSAPP="905321234567"
NEXT_PUBLIC_EMAIL="info@ysmn.com"
NEXT_PUBLIC_INSTAGRAM="ysmn"

# Yayınlanan adres — sitemap, hreflang ve seçki paylaşım linkleri bunu kullanır
NEXT_PUBLIC_SITE_URL="https://ysmn.com"

# ── Yönetim paneli (/admin) ──
# ADMIN_PASSWORD tanımlı değilse panel tümüyle kapalıdır. En az 8 karakter.
ADMIN_PASSWORD="uzun-ve-tahmin-edilemez-bir-sifre"
# Oturum kurabiyesini imzalayan anahtar. Zorunlu değil ama verilmesi tercih
# edilir; verilmezse şifreden türetilir (şifre değişince oturumlar düşer).
ADMIN_SECRET="rastgele-uretilmis-uzun-bir-dize"

# ── Katalog deposu ──
# Vercel projesinde bir Blob deposu oluşturunca bu değişken otomatik gelir.
# Tanımlıysa katalog ve fotoğraflar Blob'a yazılır; tanımlı değilse proje
# dosyalarına (yalnızca yerel geliştirmede çalışır).
# Vercel'de Blob deposunu projeye bağlayınca gerekli değişkenler otomatik
# gelir (bugün BLOB_STORE_ID; kimlik doğrulama çalışma anındaki OIDC ile).
# Yerelde Blob'a bağlanmak isterseniz statik token da kullanılabilir:
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
